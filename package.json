{
  "name": "innova-clients",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "bootstrap": "pnpm -w install",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @innova/web dev",
    "dev:mobile-student": "pnpm --filter @innova/mobile-student start",
    "dev:mobile-parent": "pnpm --filter @innova/mobile-parent start",
    "dev:landing": "pnpm --filter superprofes-landing dev",
    "dev:backend": "npm --prefix ../innova-backend-serverless run start:dev",
    "ai:test": "cd ../innova-ai-engine && uv run pytest",
    "assets": "node scripts/copy-design-system-to-public.js landing/public/design-system",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:e2e": "pnpm --filter @innova/web exec playwright test",
    "gen:openapi": "npx @openapitools/openapi-generator-cli generate -i https://raw.githubusercontent.com/vruizz22/innova-backend-serverless/main/docs/openapi.json -g typescript-axios -o packages/api-client",
    "codegen:error-tags": "node packages/error-catalog/scripts/codegen.mjs",
    "format": "turbo run format",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "turbo": "^1.10.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^2.8.8",
    "vitest": "^1.3.0",
    "@testing-library/react": "^14.0.0",
    "jsdom": "^22.0.0",
    "@types/jsdom": "^21.1.0",
    "@openapitools/openapi-generator-cli": "^2.4.32",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "msw": "^1.2.1",
    "typescript": "~5.3.3"
  }
}
