{
  "name": "innova-clients",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "SuperProfes-Design-System"
  ],
  "scripts": {
    "bootstrap": "pnpm -w install",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "lint:fix": "pnpm -r --filter \"@innova/**\" run lint --fix || true",
    "test:unit": "vitest run -r",
    "gen:openapi": "npx @openapitools/openapi-generator-cli generate -i https://raw.githubusercontent.com/vruizz22/innova-backend-serverless/main/docs/openapi.json -g typescript-axios -o packages/api-client",
    "format": "turbo run format"
  },
    "devDependencies": {
    "turbo": "^1.10.0",
    "eslint": "^8.50.0",
    "prettier": "^2.8.8",
    "vitest": "^1.3.0",
    "@testing-library/react": "^14.0.0",
    "jsdom": "^22.0.0",
    "@types/jsdom": "^21.1.0",
    "@openapitools/openapi-generator-cli": "^2.4.32",
    "msw": "^1.2.1"
  }
}
