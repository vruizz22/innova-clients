{
  "name": "superprofes-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/copy-design-system-to-public.js ./public/design-system && astro dev --host 0.0.0.0 --port 3004",
    "build": "node ../scripts/copy-design-system-to-public.js ./public/design-system && astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write ./src/**/*",
    "check-paths": "node ../scripts/check-absolute-paths.js ./"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "astro": "^3.5.0",
    "astro-eslint-parser": "^0.17.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.31.0",
    "playwright": "^1.61.0",
    "postcss": "^8.4.0",
    "prettier": "^2.8.0",
    "tailwindcss": "^3.4.19"
  }
}
