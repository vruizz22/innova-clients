---
// Layout.astro — alias for BaseLayout.astro (referenced by task spec)
// Delegates to BaseLayout for the full HTML shell.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <slot />
</BaseLayout>
