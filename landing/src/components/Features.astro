---
// Features — 3-col feature grid (6 features)

interface Feature {
  icon: string;
  title: string;
  description: string;
  badge?: string;
}

const features: Feature[] = [
  {
    icon: 'lightning',
    title: 'Detección en tiempo real',
    description: 'El motor de reglas clasifica el error procedural exacto en menos de 100ms. No solo "está malo", sino exactamente qué falló: BORROW_OMITTED_TENS, CARRY_ERROR, etc.',
    badge: '<100ms',
  },
  {
    icon: 'chart',
    title: 'Dashboard del profesor',
    description: 'Heatmap de dominio por alumno y habilidad. Verde, amarillo, rojo. En 30 segundos sabés quiénes están en riesgo antes del viernes.',
  },
  {
    icon: 'target',
    title: 'Práctica focalizada',
    description: 'El sistema asigna automáticamente ejercicios diseñados para el error específico detectado. Sin trabajo extra para el profesor.',
  },
  {
    icon: 'camera',
    title: 'OCR manuscrito',
    description: 'Los alumnos suben fotos de sus cuadernos. El sistema extrae los pasos escritos a mano y los analiza con el mismo motor de reglas.',
  },
  {
    icon: 'trending',
    title: 'Tracking de dominio BKT',
    description: 'Bayesian Knowledge Tracing rastrea el p_known de cada (alumno, habilidad) a lo largo del tiempo. El progreso es visible y accionable.',
  },
  {
    icon: 'bell',
    title: 'Alertas tempranas',
    description: 'Te llega una alerta AT_RISK_SKILL cuando un alumno acumula errores del mismo tipo antes de la evaluación. A tiempo para intervenir.',
  },
];
---

<section id="caracteristicas" class="bg-[var(--slate-50)] py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-10">
    <!-- Section header -->
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[var(--sky-600)]">
        Características
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-[var(--slate-800)] md:text-4xl">
        Todo lo que necesitás para diagnosticar tu curso
      </h2>
      <p class="mt-4 text-base leading-relaxed text-[var(--fg-2)] md:text-lg">
        Diseñado para profesores de 3° a 6° básico. Sin curva de aprendizaje, sin configuración, listo el primer día.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="feature-card group relative overflow-hidden rounded-2xl border border-[var(--border)] bg-white p-6 shadow-[var(--shadow-card)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[var(--shadow-pop)]">
          <div class="mb-4 flex items-start justify-between">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--sky-50)]">
              {feature.icon === 'lightning' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sky-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              )}
              {feature.icon === 'chart' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sky-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
              )}
              {feature.icon === 'target' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sky-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              )}
              {feature.icon === 'camera' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sky-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
              )}
              {feature.icon === 'trending' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sky-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
              )}
              {feature.icon === 'bell' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sky-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
              )}
            </div>
            {feature.badge && (
              <span class="rounded-full bg-[var(--mint-50)] px-2.5 py-1 text-[11px] font-bold text-[var(--mint-700)]">
                {feature.badge}
              </span>
            )}
          </div>
          <h3 class="mb-2 text-base font-semibold text-[var(--slate-800)]">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-[var(--fg-2)]">{feature.description}</p>

          <!-- Hover accent line -->
          <div class="absolute bottom-0 left-0 h-0.5 w-0 bg-gradient-to-r from-[var(--sky-500)] to-[var(--mint-500)] transition-all duration-300 group-hover:w-full"></div>
        </article>
      ))}
    </div>
  </div>
</section>
