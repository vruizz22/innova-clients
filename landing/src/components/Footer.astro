---
// Footer — DS spec
const practiceUrl = import.meta.env.PUBLIC_PRACTICE_URL ?? 'http://localhost:3002';
const teacherUrl = import.meta.env.PUBLIC_TEACHER_URL ?? 'http://localhost:3001';
---

<footer class="border-t border-[var(--border)] bg-[var(--slate-800)] py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-10">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr] md:gap-12">
      <!-- Brand column -->
      <div class="flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2.5" aria-label="SuperProfes — inicio">
          <img src="/design-system/assets/superprofes-mark.svg" alt="" class="h-9 w-9 rounded-xl" />
          <span class="text-base font-bold text-white">
            Super<span style="color: var(--sky-400);">Profes</span>
          </span>
        </a>
        <p class="t-body-sm leading-relaxed text-white/50">
          Detección temprana. Aprendizaje mejor.
        </p>
        <a href="mailto:innova.grupo23@gmail.com" class="t-caption text-white/40 hover:text-white/70 transition-colors">
          innova.grupo23@gmail.com
        </a>
      </div>

      <!-- Producto -->
      <div>
        <p class="mb-4 t-allcaps text-white/35">Producto</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#caracteristicas" class="footer-link">Funcionalidades</a></li>
          <li><a href="#precios" class="footer-link">Precios</a></li>
          <li><a href={`${practiceUrl}/login`} class="footer-link">Practice</a></li>
          <li><a href={`${teacherUrl}/login`} class="footer-link">Teacher</a></li>
          <li><a href="/design-system/preview/components-buttons.html" class="footer-link">Design System</a></li>
          <li><a href="mailto:innova.grupo23@gmail.com?subject=Contacto%20SuperProfes" class="footer-link">Contacto</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="mb-4 t-allcaps text-white/35">Legal</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#" class="footer-link">Privacidad</a></li>
          <li><a href="#" class="footer-link">Términos</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-white/8 pt-8 sm:flex-row sm:items-center">
      <p class="t-caption text-white/30">
        &copy; 2026 Innova EdTech · innova.grupo23@gmail.com
      </p>
      <p class="t-caption text-white/20">
        Ley 21.180 · COPPA · MINEDUC OA
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .footer-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }
</style>
