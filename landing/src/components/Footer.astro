---
// Footer
---

<footer class="border-t border-[var(--border)] bg-[var(--slate-800)] py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-10">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr] md:gap-12">
      <!-- Brand column -->
      <div class="flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3" aria-label="SuperProfes — inicio">
          <div class="grid h-9 w-9 place-items-center rounded-xl bg-[var(--sky-600)]">
            <span class="text-sm font-bold text-white">SP</span>
          </div>
          <span class="text-base font-semibold text-white">SuperProfes</span>
        </a>
        <p class="text-sm leading-relaxed text-white/50">
          Diagnóstico matemático procedural para profesores chilenos. Detecta el error específico antes de la prueba.
        </p>
        <div class="flex flex-col gap-1 text-xs text-white/30">
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Cumple con Ley 21.180 · COPPA · MINEDUC OA
          </span>
        </div>
      </div>

      <!-- Producto -->
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-wider text-white/35">Producto</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#caracteristicas" class="footer-link">Características</a></li>
          <li><a href="#como-funciona" class="footer-link">Cómo funciona</a></li>
          <li><a href="#precios" class="footer-link">Pricing</a></li>
          <li><a href="#contacto" class="footer-link">Solicitar demo</a></li>
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-wider text-white/35">Empresa</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#contacto" class="footer-link">Contacto</a></li>
          <li>
            <a
              href="mailto:innova.grupo23@gmail.com"
              class="footer-link"
            >
              innova.grupo23@gmail.com
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-wider text-white/35">Legal</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#" class="footer-link">Privacidad</a></li>
          <li><a href="#" class="footer-link">Términos de uso</a></li>
          <li><a href="#" class="footer-link">Política COPPA</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-white/8 pt-8 sm:flex-row sm:items-center">
      <p class="text-xs text-white/30">
        &copy; 2026 Innova EdTech SpA · Santiago, Chile
      </p>
      <p class="text-xs text-white/20">
        Hecho con mucho café y datos reales de aula
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .footer-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }
</style>
