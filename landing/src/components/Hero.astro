---
// Hero — full-screen, dark gradient background, mastery heatmap mockup
---

<section
  id="inicio"
  class="relative flex min-h-screen flex-col justify-center overflow-hidden bg-[linear-gradient(150deg,var(--sky-800)_0%,#0f2f45_55%,#0a1a2a_100%)] pt-20"
>
  <!-- Background decorative blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 -left-32 h-[600px] w-[600px] rounded-full bg-[var(--sky-600)] opacity-10 blur-[120px]"></div>
    <div class="absolute top-1/2 -right-48 h-[500px] w-[500px] rounded-full bg-[var(--mint-500)] opacity-8 blur-[140px]"></div>
    <div class="absolute bottom-0 left-1/3 h-[400px] w-[400px] rounded-full bg-[var(--sky-500)] opacity-6 blur-[160px]"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-16 md:px-8 lg:px-10 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: copy -->
      <div class="flex flex-col gap-6">
        <!-- Badge -->
        <div class="inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/8 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-[var(--sky-300)]">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--mint-400)]"></span>
          EdTech · Diagnóstico matemático
        </div>

        <!-- Headline — DS spec: t-display-1 -->
        <h1 class="t-display-1 text-white">
          Detecta cómo aprende tu alumno,<br />
          <span class="bg-gradient-to-r from-[var(--sky-300)] to-[var(--mint-400)] bg-clip-text text-transparent">
            en tiempo real.
          </span>
        </h1>

        <!-- Subheadline — DS spec: t-body -->
        <p class="t-body max-w-xl text-white/80">
          SuperProfes convierte cada ejercicio en datos accionables para el docente.
        </p>

        <!-- CTAs — DS spec -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="mailto:innova.grupo23@gmail.com?subject=Solicitud%20piloto%20SuperProfes"
            class="btn btn-primary shadow-lg"
            style="box-shadow: 0 8px 24px rgba(15,42,61,0.25);"
          >
            Solicitar piloto gratuito
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="#como-funciona"
            class="btn"
            style="border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: white; backdrop-filter: blur(8px);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Ver demo
          </a>
        </div>

        <!-- Stats bar -->
        <div class="mt-4 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6">
          <div class="flex flex-col">
            <span class="text-2xl font-bold text-white">20+</span>
            <span class="text-sm text-white/55">colegios piloto</span>
          </div>
          <div class="h-auto w-px bg-white/10"></div>
          <div class="flex flex-col">
            <span class="text-2xl font-bold text-white">5.000+</span>
            <span class="text-sm text-white/55">alumnos activos</span>
          </div>
          <div class="h-auto w-px bg-white/10"></div>
          <div class="flex flex-col">
            <span class="text-2xl font-bold text-white">&lt;100ms</span>
            <span class="text-sm text-white/55">detección de error</span>
          </div>
        </div>
      </div>

      <!-- Right: dashboard mockup -->
      <div class="relative flex justify-center lg:justify-end">
        <div class="w-full max-w-[500px] overflow-hidden rounded-2xl border border-white/12 bg-[var(--sky-900)]/60 shadow-[0_32px_80px_rgba(0,0,0,0.45)] backdrop-blur-md">
          <!-- Mockup header -->
          <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
            <div class="flex items-center gap-2">
              <div class="h-2.5 w-2.5 rounded-full bg-[#FF6058]"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-[#FFBD2D]"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-[#29C940]"></div>
            </div>
            <span class="text-xs font-medium text-white/40">Dashboard del Profesor — 4° Básico A</span>
            <div></div>
          </div>

          <div class="p-4 md:p-5">
            <!-- Alert banner -->
            <div class="mb-4 flex items-center gap-3 rounded-xl bg-[var(--mastery-weak)]/15 border border-[var(--mastery-weak)]/25 px-3 py-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D86060" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              <div class="flex-1">
                <p class="text-xs font-semibold text-[#D86060]">3 alumnos en riesgo · Resta con reagrupación</p>
                <p class="text-[11px] text-white/45 mt-0.5">Error detectado: BORROW_OMITTED_TENS</p>
              </div>
            </div>

            <!-- Heatmap table -->
            <div class="mb-3 flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-white/45">Dominio por habilidad</p>
              <p class="text-[11px] text-white/30">Semana 18</p>
            </div>

            <!-- Skill headers -->
            <div class="overflow-x-auto">
              <table class="w-full text-[11px]">
                <thead>
                  <tr class="text-white/35">
                    <th class="pb-2 pr-3 text-left font-medium">Alumno</th>
                    <th class="pb-2 px-1 text-center font-medium">Suma</th>
                    <th class="pb-2 px-1 text-center font-medium">Resta</th>
                    <th class="pb-2 px-1 text-center font-medium">×</th>
                    <th class="pb-2 px-1 text-center font-medium">÷</th>
                    <th class="pb-2 px-1 text-center font-medium">Frac.</th>
                  </tr>
                </thead>
                <tbody class="space-y-1">
                  <tr class="border-t border-white/5">
                    <td class="py-1.5 pr-3 font-medium text-white/70">Sofía M.</td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.9</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.8</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.6</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.5</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.7</span></td>
                  </tr>
                  <tr class="border-t border-white/5">
                    <td class="py-1.5 pr-3 font-medium text-white/70">Diego R.</td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.6</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.2</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.3</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.2</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.4</span></td>
                  </tr>
                  <tr class="border-t border-white/5">
                    <td class="py-1.5 pr-3 font-medium text-white/70">Valentina C.</td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.8</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.3</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.5</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.7</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.6</span></td>
                  </tr>
                  <tr class="border-t border-white/5">
                    <td class="py-1.5 pr-3 font-medium text-white/70">Matías P.</td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.9</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.7</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.8</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.6</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-strong inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.7</span></td>
                  </tr>
                  <tr class="border-t border-white/5">
                    <td class="py-1.5 pr-3 font-medium text-white/70">Isidora L.</td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.5</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.2</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.3</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-medium inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.4</span></td>
                    <td class="py-1.5 px-1 text-center"><span class="mastery-cell mastery-weak inline-flex h-7 w-7 items-center justify-center rounded-lg text-[11px] font-bold">0.3</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Legend -->
            <div class="mt-4 flex items-center justify-end gap-4 text-[10px] text-white/35">
              <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-sm bg-[var(--mastery-strong)]/30"></div>
                <span>Dominado ≥0.7</span>
              </div>
              <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-sm bg-[var(--mastery-medium)]/30"></div>
                <span>En proceso</span>
              </div>
              <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-sm bg-[var(--mastery-weak)]/30"></div>
                <span>En riesgo</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating error badge -->
        <div class="absolute -bottom-4 -left-4 flex items-center gap-2.5 rounded-xl border border-white/10 bg-[var(--sky-800)] px-3.5 py-2.5 shadow-xl backdrop-blur-sm md:bottom-8 md:-left-8">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--mastery-weak)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D86060" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          </div>
          <div>
            <p class="text-[11px] font-bold text-white">BORROW_OMITTED_TENS</p>
            <p class="text-[10px] text-white/45">Detectado · Resta 3 dígitos</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="relative z-10 flex justify-center pb-8">
    <a href="#caracteristicas" class="flex flex-col items-center gap-2 text-white/30 transition-colors hover:text-white/60" aria-label="Ver características">
      <span class="text-xs font-medium tracking-widest uppercase">Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </div>
</section>
