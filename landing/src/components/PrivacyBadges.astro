---
// PrivacyBadges — DS spec from brand-privacy.html
---

<section class="border-t border-[var(--border)] bg-[var(--bg-subtle)] py-10">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-10">
    <p class="t-caption mb-6 text-center text-[var(--fg-3)] uppercase tracking-widest">
      Privacidad y cumplimiento
    </p>
    <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
      <!-- EXIF eliminado -->
      <div class="flex items-center gap-2.5 rounded-pill border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5" style="border-radius: var(--r-pill);">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--fg-2)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="t-body-sm text-[var(--fg-2)]">EXIF eliminado al subir</span>
      </div>

      <!-- Sin trackers -->
      <div class="flex items-center gap-2.5 rounded-pill border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5" style="border-radius: var(--r-pill);">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--mint-600)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="t-body-sm text-[var(--fg-2)]">Sin trackers de terceros</span>
      </div>

      <!-- COPPA / Ley 21.180 -->
      <div class="flex items-center gap-2.5 rounded-pill border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5" style="border-radius: var(--r-pill);">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--sky-600)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span class="t-body-sm text-[var(--fg-2)]">COPPA · Ley 21.180</span>
      </div>
    </div>
  </div>
</section>
