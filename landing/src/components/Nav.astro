---
// Nav.astro — top navigation with logo + CTA button
// Thin wrapper around Header.astro to satisfy task spec naming.
import { registerUrl, teacherUrl, practiceUrl, parentUrl } from '@config/urls'
const loginUrl = '/auth'
import SmartLoginButton from '@components/SmartLoginButton.astro'
import Logo from '@components/Logo.astro'
---

<nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4 md:px-10">
  <!-- Brand logo — shared DS wordmark, white on the dark hero -->
  <a href="/" class="group flex items-center text-white" aria-label="SuperProfes — ir a inicio">
    <Logo variant="full" height={28} class="text-white" />
  </a>

  <!-- Links -->
  <div class="hidden md:flex items-center gap-6 text-sm font-medium text-white/70">
    <a href="#caracteristicas" class="hover:text-white transition-colors">Características</a>
    <a href="#como-funciona" class="hover:text-white transition-colors">Cómo funciona</a>
    <a href="#precios" class="hover:text-white transition-colors">Precios</a>
  </div>

  <!-- CTA -->
  <div class="flex items-center gap-3">
    <SmartLoginButton
      loginUrl={loginUrl}
      teacherUrl={teacherUrl}
      practiceUrl={practiceUrl}
      parentUrl={parentUrl}
      class="hidden sm:inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold text-white/80 border border-white/20 hover:bg-white/10 transition-all"
    />
    <a
      href={registerUrl}
      class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold text-white bg-[var(--sky-500)] hover:bg-[var(--sky-600)] transition-all shadow-md"
      data-auth-cta="register"
    >
      Comenzar gratis
    </a>
  </div>
</nav>
