---
// CTA — bottom call-to-action section
const practiceUrl = import.meta.env.PUBLIC_PRACTICE_URL ?? 'http://localhost:3002';
const teacherUrl = import.meta.env.PUBLIC_TEACHER_URL ?? 'http://localhost:3001';
---

<section
  id="contacto"
  class="relative overflow-hidden bg-[linear-gradient(135deg,var(--sky-800)_0%,#0f2f45_55%,#0a1a2a_100%)] py-20 md:py-28"
>
  <!-- Background decorative blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-24 right-0 h-[400px] w-[400px] rounded-full bg-[var(--sky-500)] opacity-10 blur-[120px]"></div>
    <div class="absolute bottom-0 left-0 h-[300px] w-[300px] rounded-full bg-[var(--mint-500)] opacity-8 blur-[100px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-3xl px-4 text-center md:px-8">
    <!-- Badge -->
    <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/8 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-[var(--sky-300)]">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--mint-400)]"></span>
      Piloto gratuito disponible
    </div>

    <h2 class="mb-5 text-3xl font-bold leading-[1.15] tracking-tight text-white md:text-4xl lg:text-5xl">
      ¿Listo para conocer los errores de tu curso
      <span class="bg-gradient-to-r from-[var(--sky-300)] to-[var(--mint-400)] bg-clip-text text-transparent">
        antes de la prueba?
      </span>
    </h2>

    <p class="mb-10 text-lg leading-relaxed text-white/65 md:text-xl">
      Agenda una demo de 30 minutos. Sin compromiso, sin tarjeta de crédito. Solo te mostramos lo que verías de tu curso mañana mismo.
    </p>

    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={`${practiceUrl}/login`}
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--sky-500)] px-8 py-4 text-base font-semibold text-white shadow-lg shadow-black/25 transition-all hover:bg-[var(--sky-600)] hover:-translate-y-px active:scale-95 sm:w-auto"
      >
        Entrar como alumno
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a
        href={`${teacherUrl}/login`}
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/8 px-8 py-4 text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/14 hover:border-white/30 active:scale-95 sm:w-auto"
      >
        Entrar como profesor
      </a>
    </div>

    <!-- Trust signals -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-xs text-white/40">
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Ley 21.180 · COPPA
      </div>
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Sin permanencia mínima
      </div>
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Alineado a OA MINEDUC
      </div>
    </div>
  </div>
</section>
