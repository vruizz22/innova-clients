---
// Pricing — 2 cards DS spec
---

<section id="precios" class="bg-[var(--bg-subtle)] py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-10">
    <!-- Section header -->
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[var(--sky-600)]">
        Precios
      </p>
      <h2 class="t-display-3 text-[var(--slate-800)]">
        Empieza gratis, escala cuando estés listo
      </h2>
      <p class="mt-4 t-body text-[var(--fg-2)]">
        Sin contrato de permanencia. Sin letra chica.
      </p>
    </div>

    <!-- Pricing grid — 2 cards DS spec -->
    <div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2 md:items-start">
      <!-- Piloto gratuito -->
      <div class="card flex flex-col gap-6">
        <div>
          <p class="t-caption mb-1">Piloto gratuito</p>
          <p class="t-display-2" style="color: var(--slate-800);">Gratis</p>
          <p class="t-body-sm mt-2 text-[var(--fg-2)]">Para colegios que quieren probar</p>
        </div>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Hasta 30 alumnos
          </li>
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            1 curso
          </li>
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Soporte vía email
          </li>
        </ul>
        <a
          href="mailto:innova.grupo23@gmail.com?subject=Solicitud%20piloto%20gratuito%20SuperProfes"
          class="btn btn-secondary w-full justify-center"
        >
          Comenzar gratis
        </a>
      </div>

      <!-- Escuela -->
      <div class="card flex flex-col gap-6" style="border-color: var(--sky-500); border-width: 2px; box-shadow: var(--shadow-pop);">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
          <span class="rounded-full px-4 py-1.5 text-xs font-bold text-white" style="background: var(--sky-500);">Más popular</span>
        </div>
        <div>
          <p class="t-caption mb-1">Escuela</p>
          <p class="t-display-2" style="color: var(--sky-700);">$50.000</p>
          <p class="t-body-sm mt-1 text-[var(--fg-2)]">CLP / mes por curso</p>
          <p class="t-body-sm mt-2 text-[var(--fg-2)]">Para escuelas que quieren escalar</p>
        </div>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Alumnos ilimitados
          </li>
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Todos los cursos
          </li>
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Alertas en tiempo real
          </li>
          <li class="flex items-center gap-2.5 t-body-sm text-[var(--fg-1)]">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Soporte prioritario
          </li>
        </ul>
        <a
          href="mailto:innova.grupo23@gmail.com?subject=Solicitud%20plan%20Escuela%20SuperProfes"
          class="btn btn-primary w-full justify-center"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- Footer note -->
    <p class="mt-8 text-center t-body-sm text-[var(--fg-2)]">
      Todos los planes incluyen soporte por correo + onboarding inicial. Precio en CLP + IVA.
    </p>
  </div>
</section>

<style>
  /* relative positioning for pricing badge */
  .card { position: relative; }
</style>
