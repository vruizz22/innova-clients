---
// Header — sticky, semi-transparent with blur on scroll
import { registerUrl } from '../config/urls';
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 md:px-8 lg:px-10">
    <!-- Logo — DS spec: Inter 700, "Super" slate-900 on light / white on dark, "Profes" sky-500 -->
    <a href="/" class="flex items-center gap-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sky-500)] rounded-lg" aria-label="SuperProfes — inicio">
      <img src="/design-system/assets/superprofes-mark.svg" alt="" class="h-9 w-9 rounded-xl shadow-md" />
      <span class="hidden text-base font-bold text-white sm:block">
        Super<span style="color: var(--sky-400);">Profes</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      <a href="#caracteristicas" class="nav-link">Funcionalidades</a>
      <a href="#precios" class="nav-link">Precios</a>
    </nav>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={registerUrl}
        class="btn btn-primary"
      >
        Comenzar gratis
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="relative z-50 flex h-9 w-9 flex-col items-center justify-center gap-1.5 rounded-lg p-1 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-[var(--sky-800)]/95 backdrop-blur-md lg:hidden"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-1 px-4 py-4" aria-label="Menú móvil">
      <a href="#caracteristicas" class="mobile-nav-link">Características</a>
      <a href="#como-funciona" class="mobile-nav-link">Cómo funciona</a>
      <a href="#precios" class="mobile-nav-link">Precios</a>
      <div class="mt-3 flex flex-col gap-2 border-t border-white/10 pt-3">
        <a
          href={registerUrl}
          class="rounded-xl bg-[var(--sky-500)] px-4 py-3 text-center text-sm font-semibold text-white"
        >
          Comenzar gratis
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    border-radius: 8px;
    transition: color 120ms ease, background 120ms ease;
    text-decoration: none;
  }
  .nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  .mobile-nav-link {
    display: block;
    padding: 10px 12px;
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    text-decoration: none;
    transition: color 120ms ease, background 120ms ease;
  }
  .mobile-nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }

  #site-header {
    background: transparent;
  }
  #site-header.scrolled {
    background: rgba(24, 80, 109, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  #mobile-menu.open {
    display: block;
  }
  button[aria-expanded='true'] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  button[aria-expanded='true'] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  button[aria-expanded='true'] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Scroll — add scrolled class
  const onScroll = () => {
    if (header) {
      header.classList.toggle('scrolled', window.scrollY > 24);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Hamburger toggle
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open') ?? false;
    menu?.classList.toggle('open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.setAttribute('aria-hidden', String(isOpen));
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
