---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="SuperProfes — Detecta el error antes de la prueba"
  description="Tu asistente de diagnóstico matemático para profesores chilenos. Detecta qué procedimiento está fallando cada alumno antes de la evaluación."
>
  <Header />
  <main>
    <Hero />
    <Features />
    <HowItWorks />
    <Pricing />
    <Testimonials />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
