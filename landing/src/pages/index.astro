---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Features from '@components/Features.astro';
import HowItWorks from '@components/HowItWorks.astro';
import Pricing from '@components/Pricing.astro';
import PrivacyBadges from '@components/PrivacyBadges.astro';
import Testimonials from '@components/Testimonials.astro';
import CTA from '@components/CTA.astro';
import Footer from '@components/Footer.astro';
---

<BaseLayout
  title="SuperProfes — Detecta cómo aprende tu alumno, en tiempo real"
  description="SuperProfes convierte cada ejercicio en datos accionables para el docente. Detección temprana, aprendizaje mejor."
>
  <Header />
  <main>
    <Hero />
    <Features />
    <HowItWorks />
    <Pricing />
    <PrivacyBadges />
    <Testimonials />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
