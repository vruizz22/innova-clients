---
import { DESIGN_CSS_PATH } from '@design';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>SuperProfes · Demo</title>
    <link rel="stylesheet" href={DESIGN_CSS_PATH} />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="bg-[var(--bg-canvas)] text-[var(--fg-1)]">
    <main
      class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-8 px-4 py-6 md:px-8 lg:px-10"
    >
      <section
        class="overflow-hidden rounded-[28px] border border-[color:var(--border)] bg-white shadow-[var(--shadow-card)]"
      >
        <div class="grid gap-0 lg:grid-cols-[1.2fr_.8fr]">
          <div
            class="relative flex flex-col justify-between overflow-hidden bg-[linear-gradient(160deg,var(--sky-700)_0%,var(--sky-800)_60%,#0a2138_100%)] px-6 py-8 text-white md:px-10 md:py-12"
          >
            <div
              class="absolute -right-16 -top-20 h-72 w-72 rounded-full bg-[var(--mint-400)] opacity-25 blur-[90px]"
            >
            </div>
            <div class="relative z-10 flex items-center gap-3">
              <div
                class="grid h-12 w-12 place-items-center rounded-2xl bg-white/12 ring-1 ring-white/20"
              >
                <span class="text-lg font-bold">SP</span>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-[0.18em] text-white/70">SuperProfes</p>
                <h1 class="text-3xl font-bold tracking-tight md:text-5xl">
                  Procedural math error detection
                </h1>
              </div>
            </div>
            <p class="relative z-10 mt-8 max-w-2xl text-base leading-7 text-white/88 md:text-lg">
              Teachers see the exact procedural error before the test. Students get focused
              practice. Parents get transparent progress. Everything is aligned to the brand system
              and deploys as static landing plus app clients.
            </p>
            <div class="relative z-10 mt-8 flex flex-wrap gap-3 text-sm">
              <span class="rounded-full bg-white/12 px-4 py-2 ring-1 ring-white/20">Sky + Mint</span
              >
              <span class="rounded-full bg-white/12 px-4 py-2 ring-1 ring-white/20">Inter</span>
              <span class="rounded-full bg-white/12 px-4 py-2 ring-1 ring-white/20"
                >Astro + Tailwind</span
              >
            </div>
          </div>

          <div class="grid gap-4 bg-[var(--bg-canvas)] p-6 md:p-8">
            <section class="rounded-2xl border border-[color:var(--border)] bg-white p-5 shadow-sm">
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--fg-2)]">
                Brand voice
              </p>
              <div class="mt-3 grid gap-3 text-sm leading-6 text-[var(--fg-1)]">
                <p>• Confident, friendly, and specific.</p>
                <p>• No raw probabilities in parent surfaces.</p>
                <p>• Error slugs are stable and pedagogically meaningful.</p>
              </div>
            </section>

            <section
              class="rounded-2xl border border-[color:var(--border)] bg-[var(--bg-student)] p-5 shadow-sm"
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--fg-2)]">
                Core surfaces
              </p>
              <ul class="mt-3 grid gap-2 text-sm">
                <li>Student practice</li>
                <li>Teacher dashboard</li>
                <li>Parent supervision</li>
                <li>Auth + onboarding</li>
              </ul>
            </section>
          </div>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <article
          class="rounded-[24px] border border-[color:var(--border)] bg-white p-6 shadow-[var(--shadow-card)]"
        >
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--fg-2)]">
            Color scale
          </p>
          <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4">
            <div class="rounded-2xl bg-[var(--bg-student)] p-4">Student</div>
            <div class="rounded-2xl bg-[var(--bg-parent)] p-4">Parent</div>
            <div class="rounded-2xl bg-[var(--slate-50)] p-4">Teacher</div>
            <div class="rounded-2xl bg-[var(--error-bg)] p-4">Error</div>
          </div>
        </article>

        <article
          class="rounded-[24px] border border-[color:var(--border)] bg-white p-6 shadow-[var(--shadow-card)]"
        >
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--fg-2)]">
            Typography
          </p>
          <div class="mt-5 grid gap-3">
            <div class="text-4xl font-bold tracking-tight">Detección temprana</div>
            <div class="text-2xl font-semibold tracking-tight">Mastery del aula</div>
            <div class="text-base leading-7 text-[var(--fg-2)]">
              Student journeys, teacher triage, and parent supervision flow across the same design
              language.
            </div>
          </div>
        </article>
      </section>

      <section class="grid gap-6 lg:grid-cols-3">
        <article
          class="rounded-[24px] border border-[color:var(--border)] bg-white p-6 shadow-[var(--shadow-card)]"
        >
          <p class="text-[11px] uppercase tracking-[0.16em] text-[var(--fg-2)]">Buttons</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <button class="rounded-xl bg-[var(--sky-600)] px-4 py-3 font-semibold text-white"
              >Asignar práctica</button
            >
            <button
              class="rounded-xl border border-[color:var(--border)] bg-white px-4 py-3 font-semibold text-[var(--fg-1)]"
              >Ver detalle</button
            >
          </div>
        </article>

        <article
          class="rounded-[24px] border border-[color:var(--border)] bg-white p-6 shadow-[var(--shadow-card)]"
        >
          <p class="text-[11px] uppercase tracking-[0.16em] text-[var(--fg-2)]">Privacy</p>
          <div class="mt-4 space-y-2 text-sm leading-6 text-[var(--fg-1)]">
            <p>• Photos are anonymized.</p>
            <p>• EXIF is stripped before upload.</p>
            <p>• No third-party trackers in the MVP.</p>
          </div>
        </article>

        <article
          class="rounded-[24px] border border-[color:var(--border)] bg-white p-6 shadow-[var(--shadow-card)]"
        >
          <p class="text-[11px] uppercase tracking-[0.16em] text-[var(--fg-2)]">Deploy</p>
          <div class="mt-4 space-y-2 text-sm leading-6 text-[var(--fg-1)]">
            <p>• Landing: S3 + CloudFront</p>
            <p>• Next.js apps: Vercel</p>
            <p>• Expo: EAS Build</p>
          </div>
        </article>
      </section>

      <footer class="pb-4 text-sm text-[var(--fg-2)]">© Innova EdTech · superprofes.app</footer>
    </main>
  </body>
</html>
