---
import { practiceUrl, teacherUrl, parentUrl } from '@config/urls';

const studentLoginUrl = `${practiceUrl.replace(/\/$/, '')}/login`;
const teacherLoginUrl = `${teacherUrl.replace(/\/$/, '')}/login`;
const parentLoginUrl = `${parentUrl.replace(/\/$/, '')}/login`;
const studentRegUrl = `${practiceUrl.replace(/\/$/, '')}/register`;
const parentRegUrl = `${parentUrl.replace(/\/$/, '')}/register`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — SuperProfes</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/design-system/colors_and_type.css" />
    <link rel="stylesheet" href="/design-system/ui_kits/auth/styles.css" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        font-family: var(--font-sans);
        color: var(--fg-1);
      }
      body {
        min-height: 100vh;
        background: var(--bg);
      }
      a {
        text-decoration: none;
      }

      .auth-page {
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
        background: var(--bg);
      }
      @media (max-width: 860px) {
        .auth-page {
          grid-template-columns: 1fr;
        }
        .auth-aside {
          display: none;
        }
      }

      /* ── Left brand aside ──────────────────────────────── */
      .auth-aside {
        background: linear-gradient(160deg, var(--sky-700) 0%, var(--sky-800) 60%, #0a2138 100%);
        color: #fff;
        padding: 56px 64px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
      }
      .auth-aside::before,
      .auth-aside::after {
        content: '';
        position: absolute;
        border-radius: 9999px;
        filter: blur(80px);
      }
      .auth-aside::before {
        width: 320px;
        height: 320px;
        background: var(--mint-400);
        opacity: 0.25;
        top: -120px;
        right: -80px;
      }
      .auth-aside::after {
        width: 380px;
        height: 380px;
        background: var(--sky-400);
        opacity: 0.35;
        bottom: -160px;
        left: -120px;
      }
      .aside-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 48px;
      }
      .aside-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 22px;
        letter-spacing: -0.03em;
      }
      .aside-brand-super {
        color: #fff;
      }
      .aside-brand-profes {
        color: var(--mint-300);
      }
      .aside-pitch h2 {
        font-size: 36px;
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.02em;
        max-width: 14ch;
      }
      .aside-pitch p {
        font-size: 16px;
        line-height: 1.6;
        opacity: 0.85;
        max-width: 36ch;
        margin-top: 12px;
      }
      .aside-foot {
        font-size: 13px;
        opacity: 0.7;
        display: flex;
        gap: 10px;
        align-items: center;
      }
      .aside-foot-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--mint-300);
      }

      /* ── Right form area ──────────────────────────────── */
      .auth-right {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 32px;
      }
      .auth-box {
        width: 100%;
        max-width: 400px;
      }

      /* ── Role cards ──────────────────────────────────── */
      .role-title {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
      }
      .role-subtitle {
        font-size: 14px;
        color: var(--fg-2);
        margin-bottom: 28px;
      }
      .role-cards {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .role-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 20px;
        border: 1.5px solid var(--border);
        border-radius: 14px;
        background: #fff;
        cursor: pointer;
        transition:
          border-color 160ms,
          box-shadow 160ms,
          background 160ms;
        text-decoration: none;
        color: var(--fg-1);
      }
      .role-card:hover {
        border-color: var(--sky-400);
        box-shadow: 0 0 0 3px rgba(63, 167, 214, 0.12);
        background: var(--sky-50);
      }
      .role-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
      }
      .role-icon-student {
        background: var(--sky-100);
      }
      .role-icon-teacher {
        background: var(--slate-100);
      }
      .role-icon-parent {
        background: var(--mint-100);
      }
      .role-info {
        flex: 1;
      }
      .role-label {
        font-weight: 700;
        font-size: 15px;
      }
      .role-desc {
        font-size: 13px;
        color: var(--fg-2);
        margin-top: 2px;
      }
      .role-arrow {
        color: var(--fg-3);
      }

      .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
        color: var(--fg-3);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .auth-divider::before,
      .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .auth-reg-links {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .reg-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
        font-size: 14px;
        color: var(--fg-2);
        transition:
          background 160ms,
          color 160ms;
        text-decoration: none;
      }
      .reg-link:hover {
        background: var(--bg-subtle);
        color: var(--fg-1);
      }
      .reg-link strong {
        color: var(--fg-1);
      }

      /* ── Redirect overlay (if already logged in) ──────── */
      #redirect-msg {
        display: none;
        position: fixed;
        inset: 0;
        background: #fff;
        z-index: 100;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 12px;
        font-size: 15px;
        color: var(--fg-2);
      }
      .redirect-spinner {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 3px solid var(--border);
        border-top-color: var(--sky-500);
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body>
    <!-- Redirect overlay if already logged in -->
    <div id="redirect-msg">
      <div class="redirect-spinner"></div>
      <p>Redirigiendo a tu dashboard...</p>
    </div>

    <div class="auth-page">
      <!-- Left: brand aside -->
      <aside class="auth-aside">
        <div class="aside-content">
          <div class="aside-brand">
            <span class="aside-brand-super">Super</span><span class="aside-brand-profes"
              >Profes</span
            >
          </div>
          <div class="aside-pitch">
            <h2>Detectamos el error matemático antes de la evaluación</h2>
            <p>
              Plataforma de práctica inteligente para 3°–6° básico en Chile. BKT + IRT + IA
              clasificadora de errores procedimentales.
            </p>
          </div>
          <div class="aside-foot">
            <span class="aside-foot-dot"></span>
            <span>Privacidad certificada COPPA · Ley 21.180</span>
          </div>
        </div>
      </aside>

      <!-- Right: role selector -->
      <div class="auth-right">
        <div class="auth-box">
          <h1 class="role-title">¿Quién eres?</h1>
          <p class="role-subtitle">Selecciona tu tipo de cuenta para continuar.</p>

          <div class="role-cards">
            <!-- Student -->
            <a class="role-card" href={studentLoginUrl}>
              <div class="role-icon role-icon-student">📚</div>
              <div class="role-info">
                <div class="role-label">Soy alumno</div>
                <div class="role-desc">
                  Practica matemáticas y recibe retroalimentación instantánea
                </div>
              </div>
              <svg
                class="role-arrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>

            <!-- Teacher -->
            <a class="role-card" href={teacherLoginUrl}>
              <div class="role-icon role-icon-teacher">👩‍🏫</div>
              <div class="role-info">
                <div class="role-label">Soy profe</div>
                <div class="role-desc">
                  Visualiza el dominio de tu sala y recibe alertas de alumnos en riesgo
                </div>
              </div>
              <svg
                class="role-arrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>

            <!-- Parent -->
            <a class="role-card" href={parentLoginUrl}>
              <div class="role-icon role-icon-parent">👨‍👩‍👧</div>
              <div class="role-info">
                <div class="role-label">Soy apoderado</div>
                <div class="role-desc">Sigue el progreso matemático de tu hijo/a</div>
              </div>
              <svg
                class="role-arrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>
          </div>

          <div class="auth-divider">¿No tienes cuenta?</div>

          <div class="auth-reg-links">
            <a class="reg-link" href={studentRegUrl}>
              <span>📝</span>
              <span>Crear cuenta de <strong>alumno</strong></span>
            </a>
            <a class="reg-link" href={parentRegUrl}>
              <span>👨‍👩‍👧</span>
              <span>Crear cuenta de <strong>apoderado</strong></span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ teacherUrl, practiceUrl, parentUrl }}>
      // If already logged in (shared Supabase cookie on .superprofes.app),
      // redirect to the role dashboard. Same detection as SmartLoginButton:
      // read the cookie session, no localStorage, no network round-trip.
      (() => {
        const APP_ROLES = ['student', 'teacher', 'parent', 'admin'];
        const trim = (u) => String(u || '').replace(/\/$/, '');
        const homeByRole = {
          teacher: `${trim(teacherUrl)}/dashboard`,
          student: `${trim(practiceUrl)}/practice`,
          parent: `${trim(parentUrl)}/family`,
          admin: `${trim(teacherUrl)}/error-catalog`,
        };

        function readSession() {
          const all = document.cookie ? document.cookie.split('; ') : [];
          const chunks = [];
          for (const entry of all) {
            const eq = entry.indexOf('=');
            if (eq === -1) continue;
            const name = entry.slice(0, eq);
            if (!/^sb-.+-auth-token(\.\d+)?$/.test(name)) continue;
            const m = name.match(/\.(\d+)$/);
            chunks.push({ idx: m ? parseInt(m[1], 10) : 0, value: entry.slice(eq + 1) });
          }
          if (chunks.length === 0) return null;
          chunks.sort((a, b) => a.idx - b.idx);
          let raw = chunks.map((c) => decodeURIComponent(c.value)).join('');
          if (raw.startsWith('base64-')) {
            try {
              const b64 = raw.slice(7).replace(/-/g, '+').replace(/_/g, '/');
              const pad = b64.length % 4 ? '='.repeat(4 - (b64.length % 4)) : '';
              const bin = atob(b64 + pad);
              const bytes = Uint8Array.from(bin, (ch) => ch.charCodeAt(0));
              raw = new TextDecoder().decode(bytes);
            } catch {
              return null;
            }
          }
          try {
            return JSON.parse(raw);
          } catch {
            return null;
          }
        }

        const session = readSession();
        const user = session?.user ?? session?.currentSession?.user ?? null;
        if (!user) return;
        const expEpoch = session?.expires_at ?? session?.expiresAt;
        if (typeof expEpoch === 'number' && expEpoch * 1000 < Date.now()) return;

        const app = user?.app_metadata?.role;
        const meta = user?.user_metadata?.role;
        const role = APP_ROLES.includes(app) ? app : APP_ROLES.includes(meta) ? meta : null;
        if (!role) return;

        const overlay = document.getElementById('redirect-msg');
        if (overlay) overlay.style.display = 'flex';
        window.location.replace(homeByRole[role]);
      })();
    </script>
  </body>
</html>
