{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@design/*": ["SuperProfes-Design-System/*"],
      "@design": ["SuperProfes-Design-System"],
      "@components/*": ["components/*"],
      "@components": ["components"],
      "@shared/*": ["components/*"],
      "@shared": ["components"],
      "@app/*": ["apps/*"],
      "@app": ["apps"]
    }
  },
  "include": ["apps/**/*", "components/**/*", "SuperProfes-Design-System/**/*", "landing/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/.next/**",
    "**/public/design-system/**"
  ]
}
