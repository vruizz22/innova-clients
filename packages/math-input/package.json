{
  "name": "@innova/math-input",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform numeric keypad + step-input for student practice (web). Plain numeric strings — no LaTeX for student input (MVP). Accessible: ≥44×44px targets, high-contrast.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18",
    "typescript": "~5.3.3"
  }
}
