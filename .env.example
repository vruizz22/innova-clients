# ─────────────────────────────────────────────────────────────
# innova-clients — env template (v7 · Supabase Auth)
# Copy to .env and fill. NEXT_PUBLIC_* / EXPO_PUBLIC_* leak to the client.
# SUPABASE_SERVICE_ROLE_KEY is server-only — NEVER prefix it NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ── apps/web (Next.js 14) ────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.superprofes.app
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_S3_UPLOAD_BUCKET=innova-ocr-uploads-prod

# ── apps/mobile-student, apps/mobile-parent (Expo) ───────────
EXPO_PUBLIC_API_URL=https://api.superprofes.app
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── landing (Astro) ──────────────────────────────────────────
PUBLIC_API_URL=https://api.superprofes.app
PUBLIC_APP_URL=https://app.superprofes.app
