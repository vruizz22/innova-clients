{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@design/*": ["SuperProfes-Design-System/*"],
      "@design": ["SuperProfes-Design-System"]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
